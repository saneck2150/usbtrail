{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug + BPF",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USBTRAIL_BUILD_BPF": "ON"
      }
    },
    {
      "name": "debug-no-bpf",
      "displayName": "Debug without BPF",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USBTRAIL_BUILD_BPF": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release + BPF",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USBTRAIL_BUILD_BPF": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "debug"},
    {"name": "debug-no-bpf", "configurePreset": "debug-no-bpf"},
    {"name": "release", "configurePreset": "release"}
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "debug-no-bpf",
      "configurePreset": "debug-no-bpf",
      "output": {"outputOnFailure": true}
    }
  ]
}
